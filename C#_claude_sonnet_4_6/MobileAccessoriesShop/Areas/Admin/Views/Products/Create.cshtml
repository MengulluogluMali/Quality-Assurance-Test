@model MobileAccessoriesShop.Models.Product
@{
    ViewData["Title"] = "Add Product";
    var isEdit = Model.Id > 0;
}

<div style="display:flex;min-height:calc(100vh - 68px);">
    <aside class="admin-sidebar">
        <div class="admin-nav-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
        <div class="admin-nav-section">Catalogue</div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link active"><i class="fas fa-box"></i> Products</a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link"><i class="fas fa-tags"></i> Categories</a>
        <div class="admin-nav-section">Sales</div>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link"><i class="fas fa-shopping-bag"></i> All Orders</a>
        <div class="admin-nav-section">Store</div>
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-store"></i> View Store</a>
    </aside>

    <main class="admin-content">
        <div style="max-width:720px;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:32px;">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline btn-sm">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.5px;">
                        @(isEdit ? "Edit Product" : "Add New Product")
                    </h1>
                    <p style="color:var(--text-secondary);font-size:14px;margin-top:4px;">
                        @(isEdit ? $"Editing: {Model.Name}" : "Fill in the details below")
                    </p>
                </div>
            </div>

            <form asp-area="Admin" asp-controller="Products" asp-action="@(isEdit ? "Edit" : "Create")"
                  asp-route-id="@(isEdit ? Model.Id : null)"
                  method="post" enctype="multipart/form-data" id="product-form">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-error" style="margin-bottom:20px;">
                        <i class="fas fa-exclamation-circle"></i>
                        <div>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {<div>@e.ErrorMessage</div>}
                        </div>
                    </div>
                }

                <div class="checkout-card">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:24px;"><i class="fas fa-info-circle" style="color:var(--accent-teal);"></i> Basic Info</h3>
                    <div class="form-group">
                        <label class="form-label">Product Name *</label>
                        <input class="form-control" name="Name" required value="@Model.Name" id="product-name" placeholder="e.g. Premium Leather Case – iPhone 15 Pro" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description *</label>
                        <textarea class="form-control" name="Description" required id="product-desc" style="min-height:120px;">@Model.Description</textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Category *</label>
                        <select class="form-control" name="CategoryId" required id="product-category" asp-items="ViewBag.Categories"></select>
                    </div>
                </div>

                <div class="checkout-card">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:24px;"><i class="fas fa-tag" style="color:var(--accent-teal);"></i> Pricing & Stock</h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
                        <div class="form-group">
                            <label class="form-label">Price ($) *</label>
                            <input class="form-control" type="number" step="0.01" name="Price" required value="@Model.Price" id="product-price" min="0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Original Price ($)</label>
                            <input class="form-control" type="number" step="0.01" name="OriginalPrice" value="@Model.OriginalPrice" id="product-original-price" min="0" placeholder="Optional" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Stock Quantity *</label>
                            <input class="form-control" type="number" name="StockQuantity" required value="@Model.StockQuantity" id="product-stock" min="0" />
                        </div>
                    </div>
                </div>

                <div class="checkout-card">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:24px;"><i class="fas fa-image" style="color:var(--accent-teal);"></i> Image & Settings</h3>
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div style="margin-bottom:16px;">
                            <img src="@Model.ImagePath" style="width:120px;height:120px;object-fit:cover;border-radius:12px;border:1px solid var(--border);" />
                        </div>
                    }
                    <div class="form-group">
                        <label class="form-label">Product Image</label>
                        <input class="form-control" type="file" name="image" id="product-image" accept="image/*" />
                    </div>
                    <div style="display:flex;gap:24px;margin-top:8px;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;">
                            <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")
                                   id="product-active" style="accent-color:var(--accent-purple);" />
                            Active (visible in store)
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;">
                            <input type="checkbox" name="IsFeatured" value="true" @(Model.IsFeatured ? "checked" : "")
                                   id="product-featured" style="accent-color:var(--accent-purple);" />
                            ⭐ Featured on homepage
                        </label>
                    </div>
                </div>

                <div style="display:flex;gap:12px;">
                    <button type="submit" class="btn btn-primary btn-lg" id="save-product-btn">
                        <i class="fas fa-save"></i> @(isEdit ? "Save Changes" : "Create Product")
                    </button>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-lg">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </main>
</div>
