@model List<MobileAccessoriesShop.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div style="display:flex;min-height:calc(100vh - 68px);">
    <aside class="admin-sidebar">
        <div class="admin-nav-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
        <div class="admin-nav-section">Catalogue</div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link"><i class="fas fa-box"></i> Products</a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link active"><i class="fas fa-tags"></i> Categories</a>
        <div class="admin-nav-section">Sales</div>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link"><i class="fas fa-shopping-bag"></i> All Orders</a>
        <div class="admin-nav-section">Store</div>
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-store"></i> View Store</a>
    </aside>

    <main class="admin-content">
        <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;margin-bottom:32px;">Categories</h1>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">
            <!-- Category List -->
            <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;overflow:hidden;">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Products</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            @if (!string.IsNullOrEmpty(cat.IconClass)) { <i class="@cat.IconClass" style="color:var(--accent-teal);"></i> }
                                            <span style="font-weight:600;">@cat.Name</span>
                                        </div>
                                        <div style="font-size:12px;color:var(--text-secondary);">/@cat.Slug</div>
                                    </td>
                                    <td style="color:var(--text-secondary);">@cat.Products.Count</td>
                                    <td>
                                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@cat.Id" method="post"
                                              onsubmit="return confirm('Delete @cat.Name?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" @(cat.Products.Any() ? "disabled title=Has products" : "")>
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Add Category Form -->
            <div class="checkout-card">
                <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;"><i class="fas fa-plus" style="color:var(--accent-teal);"></i> Add New Category</h3>
                <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" id="add-category-form">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Category Name *</label>
                        <input class="form-control" name="name" required id="category-name" placeholder="e.g. MagSafe Accessories" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Icon Class (Font Awesome)</label>
                        <input class="form-control" name="iconClass" id="category-icon" placeholder="fas fa-magnet" />
                        <small style="color:var(--text-secondary);font-size:12px;">Browse icons at <a href="https://fontawesome.com/icons" target="_blank">fontawesome.com</a></small>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="create-category-btn">
                        <i class="fas fa-plus"></i> Create Category
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>
