@model List<MobileAccessoriesShop.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<div style="display:flex;min-height:calc(100vh - 68px);">
    <aside class="admin-sidebar">
        <div class="admin-nav-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
        <div class="admin-nav-section">Catalogue</div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link"><i class="fas fa-box"></i> Products</a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link"><i class="fas fa-tags"></i> Categories</a>
        <div class="admin-nav-section">Sales</div>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link active"><i class="fas fa-shopping-bag"></i> All Orders</a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Paid" class="admin-nav-link"><i class="fas fa-clock"></i> Pending Orders</a>
        <div class="admin-nav-section">Store</div>
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-store"></i> View Store</a>
    </aside>

    <main class="admin-content">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
            <div>
                <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;">Orders</h1>
                <p style="color:var(--text-secondary);margin-top:4px;">@Model.Count orders@(ViewBag.SelectedStatus != null ? $" · Status: {ViewBag.SelectedStatus}" : "")</p>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline btn-sm @(ViewBag.SelectedStatus == null ? "active" : "")">All</a>
                @foreach (var status in new[]{"Pending","Paid","Processing","Shipped","Delivered","Cancelled"})
                {
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@status"
                       class="btn btn-outline btn-sm @(ViewBag.SelectedStatus == status ? "active" : "")">@status</a>
                }
            </div>
        </div>

        <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;overflow:hidden;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" style="text-align:center;color:var(--text-secondary);padding:40px;">No orders found.</td></tr>
                        }
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td style="font-weight:700;color:var(--accent-purple-light);">#@order.Id</td>
                                <td>
                                    <div style="font-weight:600;">@(order.User?.FullName ?? "—")</div>
                                    <div style="font-size:12px;color:var(--text-secondary);">@order.User?.Email</div>
                                </td>
                                <td style="color:var(--text-secondary);">@order.Items.Count item(s)</td>
                                <td style="font-weight:700;">$@order.TotalAmount.ToString("F2")</td>
                                <td><span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span></td>
                                <td style="font-size:13px;color:var(--text-secondary);">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline btn-sm">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
