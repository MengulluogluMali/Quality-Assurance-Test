@model MobileAccessoriesShop.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div style="display:flex;min-height:calc(100vh - 68px);">
    <aside class="admin-sidebar">
        <div class="admin-nav-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link"><i class="fas fa-chart-line"></i> Dashboard</a>
        <div class="admin-nav-section">Catalogue</div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link"><i class="fas fa-box"></i> Products</a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link"><i class="fas fa-tags"></i> Categories</a>
        <div class="admin-nav-section">Sales</div>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link active"><i class="fas fa-shopping-bag"></i> All Orders</a>
        <div class="admin-nav-section">Store</div>
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link"><i class="fas fa-store"></i> View Store</a>
    </aside>

    <main class="admin-content">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:32px;">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline btn-sm">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.5px;">Order #@Model.Id</h1>
                <p style="color:var(--text-secondary);font-size:14px;margin-top:4px;">Placed @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
            </div>
            <span class="status-badge status-@Model.Status.ToString().ToLower()" style="margin-left:auto;font-size:14px;">@Model.Status</span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 360px;gap:24px;">
            <div>
                <!-- Items Card -->
                <div class="checkout-card" style="margin-bottom:24px;">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;"><i class="fas fa-box" style="color:var(--accent-teal);"></i> Items Ordered</h3>
                    @foreach (var item in Model.Items)
                    {
                        <div style="display:flex;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--border-subtle);">
                            <div style="width:60px;height:60px;border-radius:10px;background:var(--bg-primary);display:flex;align-items:center;justify-content:center;font-size:1.8rem;overflow:hidden;flex-shrink:0;">
                                @if (!string.IsNullOrEmpty(item.Product?.ImagePath))
                                {
                                    <img src="@item.Product.ImagePath" style="width:100%;height:100%;object-fit:cover;" />
                                }
                                else { <text>📱</text> }
                            </div>
                            <div style="flex:1;">
                                <div style="font-weight:600;">@item.Product?.Name</div>
                                <div style="font-size:13px;color:var(--text-secondary);">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</div>
                            </div>
                            <div style="font-weight:800;">$@((item.Quantity * item.UnitPrice).ToString("F2"))</div>
                        </div>
                    }
                    <div style="display:flex;justify-content:flex-end;margin-top:16px;">
                        <div>
                            <div class="cart-summary-row" style="justify-content:flex-end;gap:32px;"><span>Subtotal</span><span>$@Model.TotalAmount.ToString("F2")</span></div>
                            <div class="cart-summary-total" style="gap:32px;"><span>Total</span><span style="color:var(--accent-teal);">$@Model.TotalAmount.ToString("F2")</span></div>
                        </div>
                    </div>
                </div>

                <!-- Shipping Card -->
                <div class="checkout-card">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px;"><i class="fas fa-truck" style="color:var(--accent-teal);"></i> Shipping Address</h3>
                    <div style="font-weight:700;margin-bottom:4px;">@Model.ShippingFullName</div>
                    <div style="color:var(--text-secondary);">@Model.ShippingAddress</div>
                    <div style="color:var(--text-secondary);">@Model.ShippingCity, @Model.ShippingPostalCode</div>
                    <div style="color:var(--text-secondary);">@Model.ShippingCountry</div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="divider"></div>
                        <div style="font-size:14px;"><strong>Notes:</strong> @Model.Notes</div>
                    }
                </div>
            </div>

            <!-- Right column: Status & Customer -->
            <div>
                <div class="checkout-card" style="margin-bottom:20px;">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px;"><i class="fas fa-edit" style="color:var(--accent-teal);"></i> Update Status</h3>
                    <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post" id="status-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select class="form-control" name="status" id="order-status-select" style="margin-bottom:16px;">
                            @foreach (var status in Enum.GetValues<MobileAccessoriesShop.Models.OrderStatus>())
                            {
                                if (Model.Status == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-block" id="update-status-btn">
                            <i class="fas fa-save"></i> Update Status
                        </button>
                    </form>
                    <p style="font-size:12px;color:var(--text-secondary);margin-top:12px;">
                        Changing to "Shipped" will automatically send the customer an email notification.
                    </p>
                </div>

                <div class="checkout-card">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px;"><i class="fas fa-user" style="color:var(--accent-teal);"></i> Customer</h3>
                    <div style="font-weight:700;margin-bottom:4px;">@(Model.User?.FullName ?? "—")</div>
                    <div style="color:var(--text-secondary);font-size:14px;">@Model.User?.Email</div>
                    @if (!string.IsNullOrEmpty(Model.StripePaymentIntentId))
                    {
                        <div class="divider"></div>
                        <div style="font-size:13px;color:var(--text-secondary);"><strong>Payment ID:</strong> @Model.StripePaymentIntentId</div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>
