@model List<MobileAccessoriesShop.Models.Order>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div style="display:flex;min-height:calc(100vh - 68px);">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-nav-section">Main</div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link active">
            <i class="fas fa-chart-line"></i> Dashboard
        </a>
        <div class="admin-nav-section">Catalogue</div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link">
            <i class="fas fa-box"></i> Products
        </a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link">
            <i class="fas fa-tags"></i> Categories
        </a>
        <div class="admin-nav-section">Sales</div>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link">
            <i class="fas fa-shopping-bag"></i> All Orders
        </a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Paid" class="admin-nav-link">
            <i class="fas fa-clock"></i> Pending Orders
        </a>
        <div class="admin-nav-section">Store</div>
        <a asp-controller="Home" asp-action="Index" class="admin-nav-link">
            <i class="fas fa-store"></i> View Store
        </a>
    </aside>

    <!-- CONTENT -->
    <main class="admin-content">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;">
            <div>
                <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;">Dashboard</h1>
                <p style="color:var(--text-secondary);margin-top:4px;">Welcome back, Admin 👋</p>
            </div>
            <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Product
            </a>
        </div>

        <!-- STAT CARDS -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(124,58,237,0.15);color:var(--accent-purple-light);">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stat-label">Total Revenue</div>
                <div class="stat-value" style="background:linear-gradient(135deg,#a78bfa,#38bdf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
                    $@ViewBag.TotalRevenue.ToString("F0")
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(6,182,212,0.15);color:var(--accent-teal);">
                    <i class="fas fa-calendar"></i>
                </div>
                <div class="stat-label">This Month</div>
                <div class="stat-value" style="background:linear-gradient(135deg,#38bdf8,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
                    $@ViewBag.MonthRevenue.ToString("F0")
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:var(--accent-green);">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="stat-label">Total Orders</div>
                <div class="stat-value" style="color:var(--accent-green);">@ViewBag.TotalOrders</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:var(--accent-amber);">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-label">Pending Orders</div>
                <div class="stat-value" style="color:var(--accent-amber);">@ViewBag.PendingOrders</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(124,58,237,0.15);color:var(--accent-purple-light);">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stat-label">Products</div>
                <div class="stat-value">@ViewBag.TotalProducts</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(239,68,68,0.15);color:var(--accent-red);">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-label">Low Stock</div>
                <div class="stat-value" style="color:@(ViewBag.LowStock > 0 ? "var(--accent-red)" : "var(--accent-green)");">@ViewBag.LowStock</div>
            </div>
        </div>

        <!-- RECENT ORDERS -->
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h2 style="font-size:1.1rem;font-weight:800;">Recent Orders</h2>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" style="font-size:13px;color:var(--accent-teal);">View all →</a>
        </div>

        <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;overflow:hidden;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" style="text-align:center;color:var(--text-secondary);padding:40px;">No orders yet.</td></tr>
                        }
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td style="font-weight:700;color:var(--accent-purple-light);">#@order.Id</td>
                                <td>@(order.User?.FullName ?? "Unknown")</td>
                                <td style="color:var(--text-secondary);">@order.Items.Count item(s)</td>
                                <td style="font-weight:700;">$@order.TotalAmount.ToString("F2")</td>
                                <td><span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span></td>
                                <td style="color:var(--text-secondary);font-size:13px;">@order.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-outline btn-sm">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
