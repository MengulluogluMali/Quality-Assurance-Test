@using Microsoft.AspNetCore.Identity
@inject SignInManager<MobileAccessoriesShop.Models.ApplicationUser> SignInManager
@inject UserManager<MobileAccessoriesShop.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MobileShop — Premium mobile phone accessories. Cases, chargers, earbuds, power banks and more." />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — MobileShop" : "MobileShop — Premium Phone Accessories")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon">📱</div>
            MobileShop
        </a>

        <form class="navbar-search" asp-controller="Shop" asp-action="Index" method="get">
            <i class="fas fa-search search-icon"></i>
            <input type="text" name="search" placeholder="Search accessories…" value="@ViewBag.Search" id="navbar-search-input" autocomplete="off" />
        </form>

        <ul class="navbar-nav">
            <li><a asp-controller="Shop" asp-action="Index"><i class="fas fa-store"></i> Shop</a></li>
            @if (SignInManager.IsSignedIn(User))
            {
                <li>
                    <a asp-controller="Cart" asp-action="Index">
                        <div class="cart-badge">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count" id="cart-count">0</span>
                        </div>
                        Cart
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-chart-line"></i> Admin</a></li>
                }
                <li><a asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> @UserManager.GetUserAsync(User).Result?.FullName?.Split(' ')[0]</a></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline btn-sm" style="cursor:pointer;font-family:inherit"><i class="fas fa-sign-out-alt"></i> Logout</button>
                    </form>
                </li>
            }
            else
            {
                <li>
                    <a asp-controller="Cart" asp-action="Index">
                        <div class="cart-badge">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count" id="cart-count">0</span>
                        </div>
                        Cart
                    </a>
                </li>
                <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                <li><a asp-controller="Account" asp-action="Register" class="btn-nav-cta">Get Started</a></li>
            }
        </ul>
    </nav>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin:0;border-radius:0;border-left:none;border-right:none;border-top:none;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error" style="margin:0;border-radius:0;border-left:none;border-right:none;border-top:none;">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <!-- MAIN -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="navbar-brand" style="margin-bottom:12px;">
                    <div class="brand-icon">📱</div>
                    MobileShop
                </div>
                <p>Premium mobile phone accessories for every device. Free shipping on orders over $50.</p>
            </div>
            <div>
                <p class="footer-heading">Shop</p>
                <ul class="footer-links">
                    <li><a asp-controller="Shop" asp-action="Index">All Products</a></li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-category="phone-cases">Phone Cases</a></li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-category="chargers-cables">Chargers & Cables</a></li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-category="headphones-earbuds">Headphones</a></li>
                </ul>
            </div>
            <div>
                <p class="footer-heading">Account</p>
                <ul class="footer-links">
                    <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                    <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                    <li><a asp-controller="Account" asp-action="Profile">My Orders</a></li>
                </ul>
            </div>
            <div>
                <p class="footer-heading">Support</p>
                <ul class="footer-links">
                    <li><a href="#">FAQ</a></li>
                    <li><a href="#">Returns Policy</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year MobileShop. All rights reserved.</span>
            <span>Built with ❤️ using ASP.NET Core</span>
        </div>
    </footer>

    <!-- TOAST CONTAINER -->
    <div class="toast-container" id="toast-container"></div>

    <script src="~/js/cart.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script src="~/js/push.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
