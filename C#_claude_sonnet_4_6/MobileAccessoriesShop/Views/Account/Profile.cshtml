@{
    ViewData["Title"] = "My Profile";
    var user = ViewBag.User as MobileAccessoriesShop.Models.ApplicationUser;
    var orders = ViewBag.Orders as List<MobileAccessoriesShop.Models.Order> ?? new();
}

<div class="page-header">
    <h1>👤 My Account</h1>
    <p>Welcome back, @user?.FullName</p>
</div>

<div style="max-width:900px;margin:0 auto;padding:0 40px 60px;">
    <!-- Profile info card -->
    <div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;margin-bottom:40px;">
        <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;padding:28px;text-align:center;">
            <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--accent-purple),var(--accent-teal));display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 16px;">
                @user?.FullName?.Substring(0,1).ToUpper()
            </div>
            <div style="font-weight:800;font-size:1.1rem;">@user?.FullName</div>
            <div style="color:var(--text-secondary);font-size:14px;margin-top:4px;">@user?.Email</div>
            <div style="margin-top:16px;">
                <span class="status-badge status-paid">Customer</span>
            </div>
        </div>
        <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;padding:28px;">
            <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;">Account Details</h3>
            <div style="display:grid;gap:12px;font-size:14px;">
                <div style="display:flex;"><span style="color:var(--text-secondary);width:120px;">Name</span><span style="font-weight:600;">@user?.FullName</span></div>
                <div style="display:flex;"><span style="color:var(--text-secondary);width:120px;">Email</span><span style="font-weight:600;">@user?.Email</span></div>
                <div style="display:flex;"><span style="color:var(--text-secondary);width:120px;">Phone</span><span style="font-weight:600;">@(user?.PhoneNumber ?? "Not set")</span></div>
                <div style="display:flex;"><span style="color:var(--text-secondary);width:120px;">Member Since</span><span style="font-weight:600;">@user?.CreatedAt.ToString("MMMM yyyy")</span></div>
                <div style="display:flex;"><span style="color:var(--text-secondary);width:120px;">Orders</span><span style="font-weight:600;">@orders.Count</span></div>
            </div>
        </div>
    </div>

    <!-- Order History -->
    <h2 style="font-size:1.25rem;font-weight:800;margin-bottom:20px;">📦 Order History</h2>

    @if (!orders.Any())
    {
        <div class="empty-state" style="padding:60px 0;">
            <div class="empty-icon">📭</div>
            <h3>No orders yet</h3>
            <p>Your orders will appear here once you make a purchase.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var order in orders)
        {
            <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
                    <div>
                        <span style="font-weight:800;font-size:1.1rem;">Order #@order.Id</span>
                        <span style="color:var(--text-secondary);font-size:13px;margin-left:12px;">@order.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;">
                        <span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span>
                        <span style="font-weight:800;font-size:1.1rem;color:var(--accent-teal);">$@order.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                    @foreach (var item in order.Items)
                    {
                        <div style="background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:8px;padding:8px 14px;font-size:13px;">
                            @item.Product?.Name × @item.Quantity
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
