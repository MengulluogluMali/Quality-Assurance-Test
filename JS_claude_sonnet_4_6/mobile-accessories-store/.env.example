# ─────────────────────────────────────────────
# Mobile Accessories Store — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (use any long random string)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_123!

# Admin account (auto-created on first run)
ADMIN_EMAIL=admin@mystore.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Store Admin

# ─── Stripe ───────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# ─── Email Notifications (Gmail SMTP) ─────────
# Use your Gmail address. For the password, use an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
NOTIFICATION_EMAIL=your_gmail@gmail.com   # Where to receive order alerts

# ─── Twilio SMS (optional) ────────────────────
# Get from https://console.twilio.com
# Leave blank to disable SMS notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890          # Your Twilio number
OWNER_PHONE_NUMBER=+1234567890           # YOUR phone number to receive SMS
