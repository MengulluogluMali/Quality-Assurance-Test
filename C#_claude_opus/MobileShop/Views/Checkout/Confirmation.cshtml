@model MobileShop.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card confirmation-card fade-in">
                <div class="confirmation-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 style="font-family:var(--font-display);font-weight:700;font-size:2rem;margin-bottom:0.5rem;">
                    Order Confirmed!
                </h1>
                <p style="color:var(--text-secondary);font-size:1.1rem;margin-bottom:2rem;">
                    Thank you for your purchase. Your order has been placed successfully.
                </p>

                <div class="glass-card p-4 text-start mx-auto" style="max-width:500px; background: var(--bg-glass);">
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-muted);">Order Number</span>
                        <span style="font-weight:700; color:var(--accent-primary);">#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-muted);">Date</span>
                        <span>@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-muted);">Status</span>
                        <span class="status-badge status-pending"><i class="bi bi-clock"></i> Pending</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-muted);">Ship To</span>
                        <span>@Model.FullName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-muted);">Address</span>
                        <span style="text-align:right;">@Model.ShippingAddress<br />@Model.City, @Model.ZipCode</span>
                    </div>
                    <hr style="border-color:var(--border-glass);" />
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-1">
                            <span>@item.Product?.Name <span style="color:var(--text-muted);">x@item.Quantity</span></span>
                            <span>$@((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                        </div>
                    }
                    <hr style="border-color:var(--border-glass);" />
                    <div class="d-flex justify-content-between" style="font-weight:700; font-size:1.2rem;">
                        <span>Total</span>
                        <span class="gradient-text">$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a asp-controller="Account" asp-action="Orders" class="btn btn-glass">
                        <i class="bi bi-bag-check me-2"></i>View Orders
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-glow">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
