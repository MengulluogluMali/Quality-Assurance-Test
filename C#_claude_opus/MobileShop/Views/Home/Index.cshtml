@model MobileShop.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Premium Mobile Accessories";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="hero-title fade-in">
                    Premium Accessories for<br />
                    <span class="gradient-text">Every Device</span>
                </h1>
                <p class="hero-subtitle fade-in">
                    Discover our curated collection of high-quality mobile phone accessories. 
                    From sleek cases to fast chargers — we've got everything your device needs.
                </p>
                <div class="d-flex gap-3 fade-in">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-glow btn-lg">
                        <i class="bi bi-grid-3x3-gap me-2"></i>Shop Now
                    </a>
                    <a href="#categories" class="btn btn-glass btn-lg">
                        <i class="bi bi-arrow-down me-2"></i>Explore
                    </a>
                </div>
                <div class="hero-stats fade-in">
                    <div class="hero-stat">
                        <div class="hero-stat-number">@Model.TotalProducts+</div>
                        <div class="hero-stat-label">Products</div>
                    </div>
                    <div class="hero-stat">
                        <div class="hero-stat-number">@Model.TotalCategories</div>
                        <div class="hero-stat-label">Categories</div>
                    </div>
                    <div class="hero-stat">
                        <div class="hero-stat-number">24/7</div>
                        <div class="hero-stat-label">Support</div>
                    </div>
                    <div class="hero-stat">
                        <div class="hero-stat-number">Free</div>
                        <div class="hero-stat-label">Shipping</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <div style="font-size: 12rem; opacity: 0.15; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1;">
                    <i class="bi bi-phone" style="-webkit-text-fill-color: transparent;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" class="py-5">
    <div class="container">
        <div class="section-header">
            <div class="section-tag">Browse by Category</div>
            <h2 class="section-title">Find What You Need</h2>
            <p class="section-desc">Explore our diverse range of mobile accessories organized by category.</p>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Id" class="category-card stagger-item">
                        <div class="category-card-icon">
                            <i class="bi @cat.IconClass"></i>
                        </div>
                        <div class="category-card-name">@cat.Name</div>
                        <div class="category-card-count">@cat.Products.Count products</div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="py-5">
    <div class="container">
        <div class="section-header">
            <div class="section-tag">Featured Products</div>
            <h2 class="section-title">Trending Right Now</h2>
            <p class="section-desc">Our most popular mobile accessories, handpicked for quality and value.</p>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="product-card stagger-item">
                        <div class="product-card-img-wrapper">
                            <img src="@(product.ImageUrl ?? "https://via.placeholder.com/400x300?text=No+Image")"
                                 alt="@product.Name" class="product-card-img" loading="lazy" />
                            @if (product.Stock > 10)
                            {
                                <span class="stock-badge stock-in">In Stock</span>
                            }
                            else if (product.Stock > 0)
                            {
                                <span class="stock-badge stock-low">Low Stock</span>
                            }
                            else
                            {
                                <span class="stock-badge stock-out">Out of Stock</span>
                            }
                        </div>
                        <div class="product-card-body">
                            <div class="product-card-category">@product.Category?.Name</div>
                            <h3 class="product-card-title">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                            </h3>
                            <div class="product-card-price">$@product.Price.ToString("F2")</div>
                            <div class="product-card-actions">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-glass btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                @if (product.Stock > 0)
                                {
                                    <button class="btn btn-glow btn-sm" onclick="addToCart(@product.Id)">
                                        <i class="bi bi-cart-plus"></i> Add
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-accent btn-lg">
                View All Products <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5">
    <div class="container">
        <div class="glass-card p-5 text-center" style="background: linear-gradient(135deg, rgba(0,212,255,0.05), rgba(124,58,237,0.05));">
            <h2 class="section-title mb-3">Ready to upgrade your device?</h2>
            <p class="section-desc mx-auto mb-4">Join thousands of satisfied customers who trust MobileShop for their mobile accessory needs.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-glow btn-lg">
                <i class="bi bi-person-plus me-2"></i>Create Account — It's Free
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <form id="cart-form" asp-controller="Cart" asp-action="AddToCart" method="post" style="display:none;">
    </form>
}
