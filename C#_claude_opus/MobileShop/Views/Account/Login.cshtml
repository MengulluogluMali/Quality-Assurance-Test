@model MobileShop.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="auth-card fade-in">
        <div class="text-center mb-3">
            <i class="bi bi-phone-fill" style="font-size:2.5rem; color:var(--accent-primary);"></i>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your MobileShop account</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.88rem;"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control glass-input" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control glass-input" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label" style="font-size:0.9rem; color:var(--text-secondary);">Remember me</label>
            </div>

            <button type="submit" class="btn btn-glow w-100 btn-lg mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>

            <p class="text-center" style="font-size:0.9rem; color:var(--text-muted);">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-accent" style="text-decoration:none; font-weight:600;">Create one</a>
            </p>
        </form>

        <div class="mt-3 p-3" style="background:var(--bg-glass); border-radius:var(--radius-sm); border:1px solid var(--border-glass);">
            <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem;"><strong>Demo Admin Account:</strong></p>
            <p style="font-size:0.8rem; color:var(--text-muted); margin:0;">Email: <code style="color:var(--accent-primary);">admin@mobileshop.com</code></p>
            <p style="font-size:0.8rem; color:var(--text-muted); margin:0;">Password: <code style="color:var(--accent-primary);">Admin123!</code></p>
        </div>
    </div>
</div>
