@model MobileShop.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <div class="auth-card fade-in">
        <div class="text-center mb-3">
            <i class="bi bi-person-plus-fill" style="font-size:2.5rem; color:var(--accent-primary);"></i>
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Join MobileShop and start shopping</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.88rem;"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control glass-input" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control glass-input" placeholder="Minimum 6 characters" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control glass-input" placeholder="Re-enter your password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-glow w-100 btn-lg mb-3">
                <i class="bi bi-person-check me-2"></i>Create Account
            </button>

            <p class="text-center" style="font-size:0.9rem; color:var(--text-muted);">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-accent" style="text-decoration:none; font-weight:600;">Sign in</a>
            </p>
        </form>
    </div>
</div>
