@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-container">
    <div class="auth-card text-center fade-in">
        <i class="bi bi-shield-lock" style="font-size:4rem; color:var(--danger); margin-bottom:1rem;"></i>
        <h1 class="auth-title">Access Denied</h1>
        <p class="auth-subtitle">You don't have permission to access this page.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-glow">
            <i class="bi bi-house me-2"></i>Go Home
        </a>
    </div>
</div>
