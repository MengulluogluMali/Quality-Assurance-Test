<div class="container admin-page">
  <div class="admin-header-bar">
    <div>
      <h1>📦 Manage Products</h1>
      <p class="subtitle">Add, edit, or remove products from your store.</p>
    </div>
    <a href="/admin/products/new" class="btn btn-success" id="add-new-product-btn">➕ Add New Product</a>
  </div>

  <% if (success) { %>
    <div class="alert alert-success">✅ <%= success %></div>
  <% } %>

  <% if (products.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">📦</div>
      <h3>No products yet</h3>
      <p>Start building your store by adding your first product.</p>
      <a href="/admin/products/new" class="btn btn-primary">➕ Add Product</a>
    </div>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product) { %>
            <tr>
              <td>
                <div class="admin-product-info">
                  <div class="admin-product-thumb">
                    <img src="<%= product.image_url %>" alt="<%= product.name %>">
                  </div>
                  <span><%= product.name %></span>
                </div>
              </td>
              <td><%= product.category %></td>
              <td style="color: var(--accent-emerald); font-weight: 600;">$<%= product.price.toFixed(2) %></td>
              <td>
                <% if (product.stock > 10) { %>
                  <span style="color: var(--accent-emerald);"><%= product.stock %></span>
                <% } else if (product.stock > 0) { %>
                  <span style="color: var(--accent-amber);"><%= product.stock %></span>
                <% } else { %>
                  <span style="color: var(--accent-rose);">0</span>
                <% } %>
              </td>
              <td>
                <span class="status-badge <%= product.is_active ? 'active' : 'inactive' %>">
                  <%= product.is_active ? 'Active' : 'Hidden' %>
                </span>
              </td>
              <td>
                <div class="admin-actions">
                  <a href="/admin/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">✏️ Edit</a>
                  <form action="/admin/products/<%= product.id %>/delete" method="POST" style="display: inline;"
                        onsubmit="return confirm('Are you sure you want to delete this product?')">
                    <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div style="margin-top: 2rem;">
    <a href="/admin" class="btn btn-outline">← Back to Dashboard</a>
  </div>
</div>
