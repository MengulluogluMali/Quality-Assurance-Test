@model List<MobileShop.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="page-title"><i class="bi bi-box-seam me-2"></i>Manage Products</h1>
                <div class="page-breadcrumb">
                    <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                    <i class="bi bi-chevron-right"></i>
                    <span>Products</span>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-glow">
                <i class="bi bi-plus-circle me-2"></i>Add Product
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(product.ImageUrl ?? "https://via.placeholder.com/40")"
                                     alt="" style="width:40px;height:40px;object-fit:cover;border-radius:var(--radius-sm);" />
                            </td>
                            <td style="font-weight:600;">@product.Name</td>
                            <td style="color:var(--text-muted);">@product.Category?.Name</td>
                            <td style="font-weight:600; color:var(--accent-primary);">$@product.Price.ToString("F2")</td>
                            <td>
                                @if (product.Stock > 10)
                                {
                                    <span class="status-badge status-delivered">@product.Stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="status-badge status-pending">@product.Stock</span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">0</span>
                                }
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="status-badge status-delivered">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-glass btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@product.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        <button type="submit" class="btn btn-danger-glass btn-sm">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
