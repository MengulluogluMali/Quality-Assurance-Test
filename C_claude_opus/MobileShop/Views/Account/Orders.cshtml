@model List<MobileShop.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="page-header">
    <div class="container">
        <h1 class="page-title"><i class="bi bi-bag-check me-2"></i>My Orders</h1>
        <div class="page-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="bi bi-chevron-right"></i>
            <span>My Orders</span>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="glass-card p-4 mb-3 fade-in">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 style="font-weight:700; margin:0;">Order #@order.Id</h5>
                        <span style="font-size:0.85rem; color:var(--text-muted);">@order.OrderDate.ToString("MMMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="status-badge status-@order.Status.ToString().ToLower()">
                            @order.Status
                        </span>
                        <span style="font-weight:700; font-size:1.1rem;" class="gradient-text">$@order.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
                <div class="row g-2">
                    @foreach (var item in order.OrderItems)
                    {
                        <div class="col-sm-6 col-md-4">
                            <div class="d-flex align-items-center gap-2 p-2" style="background:var(--bg-glass); border-radius:var(--radius-sm); border:1px solid var(--border-glass);">
                                <img src="@(item.Product?.ImageUrl ?? "https://via.placeholder.com/40")"
                                     alt="" style="width:40px;height:40px;object-fit:cover;border-radius:4px;" />
                                <div style="flex:1; min-width:0;">
                                    <div style="font-size:0.85rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @item.Product?.Name
                                    </div>
                                    <div style="font-size:0.75rem; color:var(--text-muted);">
                                        @item.Quantity × $@item.UnitPrice.ToString("F2")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-bag-x"></i></div>
            <h3 class="empty-state-title">No orders yet</h3>
            <p class="empty-state-desc">Start shopping to see your orders here!</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-glow">Browse Products</a>
        </div>
    }
</div>
