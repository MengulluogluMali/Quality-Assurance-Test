@model MobileStore.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="row m-0 p-0">
    <div class="col-md-6 offset-md-3">
        <div class="glass-card">
            <h3 class="mb-4">Add New Accessory</h3>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-white"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Slim Case" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-white"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label text-white"></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label text-white"></label>
                        <input asp-for="Stock" type="number" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label text-white"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Case, Charger" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label text-white"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-save"></i> Save Product</button>
            </form>
            <div class="mt-3 text-center">
                <a asp-action="Index" class="text-muted"><i class="fa-solid fa-arrow-left"></i> Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
