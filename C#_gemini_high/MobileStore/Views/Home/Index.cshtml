@model IEnumerable<MobileStore.Models.Product>

@{
    ViewData["Title"] = "Store";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-5 fw-bold text-white"><i class="fa-solid fa-bolt text-warning"></i> Premium Mobile Accessories</h1>
    <p class="lead text-muted">Level up your device without compromising on form or function.</p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="glass-card h-100">
                <img src="@p.ImageUrl" class="product-img" alt="@p.Name">
                <div class="card-body p-0 mt-3 d-flex flex-column text-white">
                    <h5 class="card-title fw-bold">@p.Name</h5>
                    <p class="card-text text-muted mb-2"><small>@p.Category</small></p>
                    <p class="card-text flex-grow-1">@p.Description</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fs-4 fw-bold text-info">@p.Price.ToString("C")</span>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-outline-primary" @(p.Stock <= 0 ? "disabled" : "")>
                                <i class="fa-solid fa-cart-plus"></i> Add
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
